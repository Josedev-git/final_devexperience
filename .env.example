APP_ENV=local
APP_BASE_PATH=
APP_TIMEZONE=America/Sao_Paulo
# Opcional: se vazio, o servidor gera e guarda a chave em storage/app.key.
APP_SECRET=
SESSION_SECURE=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=senn_aix
DB_USER=senn_app
DB_PASS=
AI_ENABLED=1
MAPS_ENABLED=1
DEPOT_LAT=-23.0264
DEPOT_LNG=-45.5553
AVERAGE_SPEED_KMH=25
ROAD_FACTOR=1.3
STOP_SERVICE_MINUTES=5
ALERT_EMAIL=
MAIL_FROM=noreply@example.com
BACKUP_DIR=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CA_FILE=
MYSQLDUMP_PATH=

# SMTP opcional. Vazio utiliza mail() configurado no PHP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USER=
SMTP_PASS=
SMTP_CA_FILE=

# Local funciona sem chave, sem chamadas a provedores. Gemini é opcional.
AI_MODE=local
